{
  "manifest_version": 3,
  "name": "Aegis AI — Scam Shield",
  "version": "1.0.0",
  "description": "Right-click any suspicious text, email, or link to scan it with Aegis AI.",
  "permissions": ["contextMenus", "activeTab", "storage", "notifications"],
  "host_permissions": ["http://localhost:8010/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Aegis AI",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
